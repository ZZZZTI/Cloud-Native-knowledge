

# ============================================================
# Makefile 语法总览（带注释）—— 可直接当模板参考
# ============================================================

# ------------------------------------------------------------
# 一、变量赋值（4 种运算符）
# ------------------------------------------------------------
CC       = gcc              # 递归赋值：用到时才展开（可能引用到后面定义的变量）
CFLAGS  := -Wall -Wextra    # 立即赋值：定义时就展开（推荐）
LIBS    ?= -lm              # 条件赋值：变量未定义时才赋值
OBJ     += main.o           # 追加：在原值后追加内容

# 使用变量：$(VAR) 或 ${VAR}；单字符变量可写 $C
CFLAGS  += -Iinclude        # 追加一个头文件搜索路径

# ------------------------------------------------------------
# 二、特殊/自动变量
# ------------------------------------------------------------
# $@  目标文件名
# $<  第一个依赖
# $^  所有依赖（去重）
# $+  所有依赖（不去重）
# $?  比目标新的依赖
# $*  模式规则中 % 匹配到的部分
# $(MAKE)    make 命令本身
# $(CURDIR)  当前目录
# $(shell pwd)  执行 shell 命令取结果

# ------------------------------------------------------------
# 三、通配符与字符串处理函数
# ------------------------------------------------------------
SRCDIR   := src
BUILDDIR := build
TARGET   := app

# wildcard：匹配存在的文件
SRCS := $(wildcard $(SRCDIR)/*.c)

# patsubst：模式替换（src/%.c -> build/%.o）
OBJS := $(patsubst $(SRCDIR)/%.c, $(BUILDDIR)/%.o, $(SRCS))

# 等价的简写替换：把 .c 换成 .o
# OBJS := $(SRCS:.c=.o)

# 其它常用字符串/文件名函数（示例）：
# $(subst 原,新,文本)            简单替换
# $(strip 文本)                  去首尾空格
# $(filter 模式,文本)            保留匹配项
# $(filter-out 模式,文本)        排除匹配项
# $(sort 列表)                   排序去重
# $(words 文本) / $(word n,文本) 单词数与取第 n 个
# $(dir 文件) / $(notdir 文件)   目录 / 文件名
# $(suffix 文件) / $(basename 文件)  后缀 / 去后缀
# $(addprefix 前缀,列表) / $(addsuffix 后缀,列表)  加前后缀
# $(foreach 变量,列表,表达式)    遍历
# $(if 条件,成立值,否则值)       条件表达式
# $(shell 命令)                  执行 shell

# ------------------------------------------------------------
# 四、条件判断（不需要 TAB 缩进）
# ------------------------------------------------------------
ifeq ($(CC), gcc)
    CFLAGS += -DUSE_GCC       # 仅当 CC 为 gcc 时追加
else ifeq ($(CC), clang)
    CFLAGS += -DUSE_CLANG
else
    CFLAGS += -DUSE_OTHER
endif

ifdef DEBUG                   # 定义了 DEBUG 时生效
    CFLAGS += -g -O0
else
    CFLAGS += -O2
endif

ifndef RELEASE                # 未定义 RELEASE 时生效
    CFLAGS += -DNO_RELEASE
endif

# ------------------------------------------------------------
# 五、自动生成头文件依赖（-MMD -MP 会生成 .d 文件）
# ------------------------------------------------------------
CFLAGS += -MMD -MP
DEPS   := $(OBJS:.o=.d)

# ------------------------------------------------------------
# 六、伪目标声明：避免同名文件导致目标不执行
# ------------------------------------------------------------
.PHONY: all clean run

# ------------------------------------------------------------
# 七、规则（目标: 依赖，命令必须用 TAB 缩进！）
# ------------------------------------------------------------
all: $(TARGET)                # 默认第一个目标，make 时会构建它

# 链接目标：$^ = 所有依赖；$@ = 目标
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LIBS)

# 模式规则：任意 build/xxx.o 由 src/xxx.c 生成
#   | $(BUILDDIR) 是“顺序依赖”（order-only）：目录不存在才创建，不会触发重建
#   $< 第一个依赖；$@ 目标
$(BUILDDIR)/%.o: $(SRCDIR)/%.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -c $< -o $@

# 单独建目录的规则
$(BUILDDIR):
	mkdir -p $@

# ------------------------------------------------------------
# 八、命令控制符
# ------------------------------------------------------------
run: $(TARGET)
	@echo "Running $(TARGET)..."       # @ 前缀：不打印该命令本身
	-./$(TARGET)                       # - 前缀：忽略该命令出错
	# +command                          # + 前缀：即使 make -n 也执行

clean:
	rm -rf $(BUILDDIR) $(TARGET)

# ------------------------------------------------------------
# 九、引入自动生成的依赖文件（-include：不存在也不报错）
# ------------------------------------------------------------
-include $(DEPS)

# ------------------------------------------------------------
# 十、常用命令行选项
#   make -f Makefile       指定文件
#   make -n                只打印不执行
#   make -j4               并行 4 个任务
#   make -B                强制重新构建
#   make -C dir            进入目录
#   make -k                出错后继续
# ------------------------------------------------------------

# ------------------------------------------------------------
# 十一、常见坑
#   1) 命令必须用 TAB 缩进，不能用空格（可用 .RECIPEPREFIX = > 改）
#   2) = 延迟展开，:= 立即展开，务必区分
#   3) $@ $< 等自动变量只在命令/规则里有效
#   4) 依赖写全，头文件依赖用 -MMD -MP 自动生成
#   5) 伪目标用 .PHONY 声明
# ------------------------------------------------------------